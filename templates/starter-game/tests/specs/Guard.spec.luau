--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local JestGlobals = require(ReplicatedStorage.DevPackages.JestGlobals)
local describe, it, expect = JestGlobals.describe, JestGlobals.it, JestGlobals.expect

local Guard = require(ReplicatedStorage.Shared.Net.Guard)

local NAN = 0 / 0
local INF = math.huge

describe("Guard.number", function()
	local check = Guard.number(0, 10)
	it("accepts finite numbers in range (inclusive)", function()
		expect(check(0)).toBe(true)
		expect(check(5.5)).toBe(true)
		expect(check(10)).toBe(true)
	end)
	it("rejects out of range, NaN, infinities and non-numbers", function()
		expect(check(-0.01)).toBe(false)
		expect(check(10.01)).toBe(false)
		expect(check(NAN)).toBe(false)
		expect(check(INF)).toBe(false)
		expect(check(-INF)).toBe(false)
		expect(check("5")).toBe(false)
		expect(check(nil)).toBe(false)
		expect(check({})).toBe(false)
	end)
	it("works without bounds", function()
		expect(Guard.number()(-1e9)).toBe(true)
		expect(Guard.number()(NAN)).toBe(false)
	end)
end)

describe("Guard.integer", function()
	it("rejects fractions", function()
		local check = Guard.integer(1, 3)
		expect(check(2)).toBe(true)
		expect(check(2.5)).toBe(false)
		expect(check(4)).toBe(false)
	end)
end)

describe("Guard.string", function()
	local check = Guard.string(5, 2)
	it("counts UTF-8 code points, not bytes", function()
		expect(check("héllo")).toBe(true) -- 5 code points, 6 bytes
		expect(check("ab")).toBe(true)
	end)
	it("enforces min and max length", function()
		expect(check("a")).toBe(false)
		expect(check("abcdef")).toBe(false)
	end)
	it("rejects invalid UTF-8 and non-strings", function()
		expect(check(string.char(255, 254))).toBe(false) -- invalid UTF-8
		expect(check(12)).toBe(false)
		expect(check(nil)).toBe(false)
	end)
end)

describe("Guard.boolean", function()
	it("accepts only booleans", function()
		expect(Guard.boolean()(true)).toBe(true)
		expect(Guard.boolean()(false)).toBe(true)
		expect(Guard.boolean()(0)).toBe(false)
		expect(Guard.boolean()(nil)).toBe(false)
	end)
end)

describe("Guard.oneOf", function()
	local check = Guard.oneOf({ MusicVolume = true, ShakeIntensity = true, [3] = true })
	it("accepts keys of the set", function()
		expect(check("MusicVolume")).toBe(true)
		expect(check(3)).toBe(true)
	end)
	it("rejects unknown keys, NaN and other types", function()
		expect(check("Coins")).toBe(false)
		expect(check(NAN)).toBe(false)
		expect(check(true)).toBe(false)
		expect(check(nil)).toBe(false)
	end)
end)

describe("Guard.vector3", function()
	it("rejects non-finite components and too-long vectors", function()
		local check = Guard.vector3(100)
		expect(check(Vector3.new(1, 2, 3))).toBe(true)
		expect(check(Vector3.new(NAN, 0, 0))).toBe(false)
		expect(check(Vector3.new(INF, 0, 0))).toBe(false)
		expect(check(Vector3.new(200, 0, 0))).toBe(false)
		expect(check({ X = 1, Y = 2, Z = 3 })).toBe(false)
	end)
end)

describe("Guard.instanceOf", function()
	it("checks class and ancestry", function()
		local part = Instance.new("Part")
		local check = Guard.instanceOf("BasePart", Workspace)
		expect(check(part)).toBe(false) -- not under Workspace yet
		part.Parent = Workspace
		expect(check(part)).toBe(true)
		expect(Guard.instanceOf("Model")(part)).toBe(false)
		expect(check("Part")).toBe(false)
		part:Destroy()
	end)
end)

describe("Guard.optional", function()
	it("allows nil or a valid value", function()
		local check = Guard.optional(Guard.string(3))
		expect(check(nil)).toBe(true)
		expect(check("abc")).toBe(true)
		expect(check("abcd")).toBe(false)
	end)
end)

describe("Guard.args", function()
	local checks = { Guard.string(20), Guard.number(0, 1) }
	it("passes a valid argument list", function()
		local ok = Guard.args(checks, "MusicVolume", 0.5)
		expect(ok).toBe(true)
	end)
	it("rejects extra arguments", function()
		local ok, reason = Guard.args(checks, "MusicVolume", 0.5, "extra")
		expect(ok).toBe(false)
		expect(reason).toMatch("too many args")
	end)
	it("rejects missing or invalid arguments with the index", function()
		local ok, reason = Guard.args(checks, "MusicVolume")
		expect(ok).toBe(false)
		expect(reason).toMatch("arg #2")
	end)
	it("accepts an empty list for no-argument remotes", function()
		expect((Guard.args({}))).toBe(true)
		expect((Guard.args({}, 1))).toBe(false)
	end)
end)
