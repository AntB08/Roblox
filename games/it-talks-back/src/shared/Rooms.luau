--!strict
-- Rooms: which room a position is in. Rooms are invisible parts tagged "RoomVolume" with a
-- "RoomName" attribute (generated by tools/build_map.py). The pure functions take explicit
-- volumes so they are unit-tested (tests/specs/Rooms.spec.luau).

local CollectionService = game:GetService("CollectionService")

export type Volume = { name: string, cframe: CFrame, size: Vector3 }

local Rooms = {}

function Rooms.contains(volume: Volume, position: Vector3): boolean
	local localPos = volume.cframe:PointToObjectSpace(position)
	local half = volume.size / 2
	return math.abs(localPos.X) <= half.X and math.abs(localPos.Y) <= half.Y and math.abs(localPos.Z) <= half.Z
end

-- First matching volume wins; volumes are sorted smallest first so overlaps resolve to the
-- most specific room.
function Rooms.find(volumes: { Volume }, position: Vector3): string?
	for _, volume in volumes do
		if Rooms.contains(volume, position) then
			return volume.name
		end
	end
	return nil
end

function Rooms.sortBySize(volumes: { Volume })
	table.sort(volumes, function(a, b)
		return a.size.X * a.size.Y * a.size.Z < b.size.X * b.size.Y * b.size.Z
	end)
end

local cache: { Volume }? = nil

function Rooms.volumes(): { Volume }
	if cache and #cache > 0 then
		return cache
	end
	local list: { Volume } = {}
	for _, inst in CollectionService:GetTagged("RoomVolume") do
		local name = inst:GetAttribute("RoomName")
		if inst:IsA("BasePart") and typeof(name) == "string" then
			table.insert(list, { name = name, cframe = inst.CFrame, size = inst.Size })
		end
	end
	Rooms.sortBySize(list)
	cache = list
	return list
end

function Rooms.at(position: Vector3): string?
	return Rooms.find(Rooms.volumes(), position)
end

return table.freeze(Rooms)
