--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local JestGlobals = require(ReplicatedStorage.DevPackages.JestGlobals)
local describe, it, expect = JestGlobals.describe, JestGlobals.it, JestGlobals.expect

local CodeFormat = require(ReplicatedStorage.Shared.Util.CodeFormat)

describe("CodeFormat.normalize", function()
	it("uppercases and strips all whitespace", function()
		expect(CodeFormat.normalize("welcome")).toBe("WELCOME")
		expect(CodeFormat.normalize("  We Lc\tome \n")).toBe("WELCOME")
	end)
	it("keeps digits, underscores and dashes", function()
		expect(CodeFormat.normalize("spring_2026-x")).toBe("SPRING_2026-X")
	end)
	it("rejects other characters", function()
		expect(CodeFormat.normalize("FREE!")).toBeNil()
		expect(CodeFormat.normalize("CÓDIGO")).toBeNil()
		expect(CodeFormat.normalize("a.b.c")).toBeNil()
	end)
	it("enforces length after stripping", function()
		expect(CodeFormat.normalize("ab")).toBeNil()
		expect(CodeFormat.normalize(" a b ")).toBeNil()
		expect(CodeFormat.normalize(string.rep("A", 32))).toBe(string.rep("A", 32))
		expect(CodeFormat.normalize(string.rep("A", 33))).toBeNil()
	end)
	it("rejects oversized raw input before normalizing", function()
		expect(CodeFormat.normalize(string.rep(" ", 38) .. "ABC")).toBeNil()
	end)
	it("rejects non-strings", function()
		expect(CodeFormat.normalize(nil)).toBeNil()
		expect(CodeFormat.normalize(123)).toBeNil()
		expect(CodeFormat.normalize({})).toBeNil()
	end)
end)
